# Spotify API Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Must exactly match a redirect URI registered in the Spotify dashboard.
# `vercel dev` (frontend + API on one origin, port 3000):
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# Deployed: https://yourdomain.com/api/auth/callback

# Where the backend redirects after login. Leave empty when frontend and API share
# an origin (Vercel, `vercel dev`). Only set it when running `npm start` + uvicorn
# separately, e.g. FRONTEND_URL=http://127.0.0.1:3000 together with
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
FRONTEND_URL=

# JWT signing key for the session cookie. Required, 32+ random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts Spotify tokens stored in the database. Required, and must be identical
# everywhere that shares the database (local + Vercel), or stored tokens can't be read.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Supabase Postgres. Dashboard -> Connect -> "Transaction pooler" (port 6543).
# Use the pooler, not the direct db.<ref>.supabase.co host (IPv6-only on free plans).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: true serves Swagger UI at /api/docs
ENABLE_API_DOCS=false
# Optional: true logs every SQL statement
SQL_ECHO=false
